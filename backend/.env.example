# --- Environnement : "production" refuse de démarrer avec JWT_SECRET / ADMIN_PASSWORD faibles
APP_ENV=development
DATABASE_URL=postgresql+psycopg://dokyra:dokyra@db:5432/dokyra

# --- LLM (OpenAI ou fournisseur compatible : renseigner OPENAI_BASE_URL)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Modèles proposés dans la page « Comparer les modèles » (séparés par des virgules)
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o
# Prix USD / 1M tokens [entrée, sortie] pour les modèles absents de la table par défaut
# MODEL_PRICES={"mon-modele":[0.5,1.5]}

# --- RAG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
USE_RERANKER=true
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=20
RETRIEVAL_TOP_N=5
MAX_UPLOAD_MB=20

# --- Sécurité (à changer !)  python -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=admin
CORS_ORIGINS=http://localhost:4200
